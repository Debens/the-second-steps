# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase PostgreSQL, London region (eu-west-2).
# Supabase dashboard > Connect > "Session pooler" connection string (ends in :5432/postgres).
DATABASE_URL="postgresql://USER.PROJECT_REF:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"
