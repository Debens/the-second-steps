// Database structure. Add tables only for the slice being built (database.mdc).
// The connection address lives in prisma.config.ts, not here (Prisma 7).

generator client {
  provider = "prisma-client"
  output   = "../core/db/generated"
}

datasource db {
  provider = "postgresql"
}

enum IdentityStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")

  @@map("identity_status")
}

enum AuthenticationProvider {
  SUPABASE @map("supabase")

  @@map("authentication_provider")
}

enum WorkspaceType {
  AGENCY            @map("agency")
  LANDLORD          @map("landlord")
  PLATFORM_INTERNAL @map("platform_internal")

  @@map("workspace_type")
}

enum WorkspaceStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  CLOSED    @map("closed")

  @@map("workspace_status")
}

enum BranchStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("branch_status")
}

enum MembershipStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  ENDED     @map("ended")

  @@map("membership_status")
}

enum MembershipScopeMode {
  WORKSPACE      @map("workspace")
  NAMED_BRANCHES @map("named_branches")

  @@map("membership_scope_mode")
}

enum MembershipRoleCode {
  WORKSPACE_OWNER  @map("workspace_owner")
  AGENCY_ADMIN     @map("agency_admin")
  BRANCH_MANAGER   @map("branch_manager")
  NEGOTIATOR       @map("negotiator")
  PROPERTY_MANAGER @map("property_manager")
  ACCOUNTS         @map("accounts")
  READ_ONLY        @map("read_only")

  @@map("membership_role_code")
}

enum PlatformRoleCode {
  PLATFORM_OWNER @map("platform_owner")

  @@map("platform_role_code")
}

enum PlatformRoleStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  ENDED     @map("ended")

  @@map("platform_role_status")
}

enum AuditOutcome {
  SUCCEEDED @map("succeeded")
  DENIED    @map("denied")
  FAILED    @map("failed")

  @@map("audit_outcome")
}

enum FeatureFlagStatus {
  ACTIVE  @map("active")
  RETIRED @map("retired")

  @@map("feature_flag_status")
}

enum ContactKind {
  PERSON       @map("person")
  ORGANISATION @map("organisation")

  @@map("contact_kind")
}

enum ContactStatus {
  ACTIVE   @map("active")
  ARCHIVED @map("archived")
  MERGED   @map("merged")

  @@map("contact_status")
}

enum OrganisationType {
  LIMITED_COMPANY @map("limited_company")
  LLP             @map("llp")
  PARTNERSHIP     @map("partnership")
  TRUST           @map("trust")
  CHARITY         @map("charity")
  OTHER           @map("other")

  @@map("organisation_type")
}

enum ContactPointKind {
  EMAIL     @map("email")
  TELEPHONE @map("telephone")

  @@map("contact_point_kind")
}

enum CommunicationChannel {
  EMAIL     @map("email")
  TELEPHONE @map("telephone")
  SMS       @map("sms")
  WHATSAPP  @map("whatsapp")
  POST      @map("post")

  @@map("communication_channel")
}

enum ContactAddressKind {
  INDIVIDUAL     @map("individual")
  REGISTERED     @map("registered")
  CORRESPONDENCE @map("correspondence")

  @@map("contact_address_kind")
}

model UserIdentity {
  id                      String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName               String?                        @map("first_name") @db.VarChar(100)
  lastName                String?                        @map("last_name") @db.VarChar(100)
  primaryEmail            String?                        @map("primary_email") @db.VarChar(254)
  status                  IdentityStatus                 @default(ACTIVE)
  createdAt               DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  providerLinks           AuthenticationProviderLink[]
  memberships             Membership[]
  platformRoles           PlatformRoleAssignment[]       @relation("PlatformRoleUser")
  platformRolesAssigned   PlatformRoleAssignment[]       @relation("PlatformRoleAssignedBy")
  membershipRolesAssigned MembershipRole[]               @relation("MembershipRoleAssignedBy")
  branchAccessAssigned    MembershipBranchAccess[]       @relation("BranchAccessAssignedBy")
  auditEvents             AuditEvent[]                   @relation("AuditActor")
  featureFlagChanges      WorkspaceFeatureFlagOverride[] @relation("FeatureFlagChangedBy")

  @@index([firstName])
  @@index([lastName])
  @@index([primaryEmail])
  @@map("user_identities")
}

model AuthenticationProviderLink {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userIdentityId  String                 @map("user_identity_id") @db.Uuid
  provider        AuthenticationProvider
  providerSubject String                 @map("provider_subject") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  userIdentity    UserIdentity           @relation(fields: [userIdentityId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userIdentityId])
  @@map("authentication_provider_links")
}

model Workspace {
  id                   String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                 String                         @unique @db.VarChar(63)
  displayName          String                         @map("display_name") @db.VarChar(160)
  legalName            String?                        @map("legal_name") @db.VarChar(160)
  companyNumber        String?                        @map("company_number") @db.VarChar(8)
  primaryEmail         String?                        @map("primary_email") @db.VarChar(254)
  telephone            String?                        @db.VarChar(32)
  website              String?                        @db.VarChar(2048)
  registeredAddress1   String?                        @map("registered_address_1") @db.VarChar(160)
  registeredAddress2   String?                        @map("registered_address_2") @db.VarChar(160)
  registeredTownCity   String?                        @map("registered_town_city") @db.VarChar(100)
  registeredCounty     String?                        @map("registered_county") @db.VarChar(100)
  registeredPostcode   String?                        @map("registered_postcode") @db.VarChar(16)
  type                 WorkspaceType
  status               WorkspaceStatus                @default(ACTIVE)
  createdAt            DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  branches             Branch[]
  memberships          Membership[]
  auditEvents          AuditEvent[]
  featureFlagOverrides WorkspaceFeatureFlagOverride[]
  contacts             Contact[]

  @@map("workspaces")
}

model Branch {
  id           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String                   @map("workspace_id") @db.Uuid
  name         String                   @db.VarChar(160)
  email        String?                  @db.VarChar(254)
  telephone    String?                  @db.VarChar(32)
  address1     String?                  @map("address_1") @db.VarChar(160)
  address2     String?                  @map("address_2") @db.VarChar(160)
  townCity     String?                  @map("town_city") @db.VarChar(100)
  county       String?                  @db.VarChar(100)
  postcode     String?                  @db.VarChar(16)
  status       BranchStatus             @default(ACTIVE)
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace    Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  access       MembershipBranchAccess[]
  contactLinks ContactBranchLink[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@map("branches")
}

model Membership {
  id                        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId               String                   @map("workspace_id") @db.Uuid
  userIdentityId            String                   @map("user_identity_id") @db.Uuid
  status                    MembershipStatus         @default(ACTIVE)
  scopeMode                 MembershipScopeMode      @map("scope_mode")
  startedAt                 DateTime                 @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt                   DateTime?                @map("ended_at") @db.Timestamptz(6)
  createdAt                 DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace                 Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  userIdentity              UserIdentity             @relation(fields: [userIdentityId], references: [id], onDelete: Restrict)
  roles                     MembershipRole[]
  branchAccess              MembershipBranchAccess[]
  auditEvents               AuditEvent[]             @relation("AuditMembership")
  contactsCreated           Contact[]                @relation("ContactCreatedBy")
  contactBranchLinksCreated ContactBranchLink[]      @relation("ContactBranchLinkCreatedBy")

  @@unique([workspaceId, userIdentityId])
  @@unique([workspaceId, id])
  @@index([userIdentityId, status])
  @@index([workspaceId, status])
  @@map("memberships")
}

model MembershipRole {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId              String             @map("workspace_id") @db.Uuid
  membershipId             String             @map("membership_id") @db.Uuid
  roleCode                 MembershipRoleCode @map("role_code")
  assignedByUserIdentityId String?            @map("assigned_by_user_identity_id") @db.Uuid
  assignedAt               DateTime           @default(now()) @map("assigned_at") @db.Timestamptz(6)
  membership               Membership         @relation(fields: [workspaceId, membershipId], references: [workspaceId, id], onDelete: Cascade)
  assignedBy               UserIdentity?      @relation("MembershipRoleAssignedBy", fields: [assignedByUserIdentityId], references: [id], onDelete: SetNull)

  @@unique([membershipId, roleCode])
  @@index([workspaceId, roleCode])
  @@index([assignedByUserIdentityId])
  @@map("membership_roles")
}

model MembershipBranchAccess {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId              String        @map("workspace_id") @db.Uuid
  membershipId             String        @map("membership_id") @db.Uuid
  branchId                 String        @map("branch_id") @db.Uuid
  assignedByUserIdentityId String?       @map("assigned_by_user_identity_id") @db.Uuid
  assignedAt               DateTime      @default(now()) @map("assigned_at") @db.Timestamptz(6)
  membership               Membership    @relation(fields: [workspaceId, membershipId], references: [workspaceId, id], onDelete: Cascade)
  branch                   Branch        @relation(fields: [workspaceId, branchId], references: [workspaceId, id], onDelete: Cascade)
  assignedBy               UserIdentity? @relation("BranchAccessAssignedBy", fields: [assignedByUserIdentityId], references: [id], onDelete: SetNull)

  @@unique([membershipId, branchId])
  @@index([workspaceId, branchId])
  @@index([assignedByUserIdentityId])
  @@map("membership_branch_access")
}

model PlatformRoleAssignment {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userIdentityId           String             @map("user_identity_id") @db.Uuid
  roleCode                 PlatformRoleCode   @map("role_code")
  status                   PlatformRoleStatus @default(ACTIVE)
  assignedByUserIdentityId String?            @map("assigned_by_user_identity_id") @db.Uuid
  assignedAt               DateTime           @default(now()) @map("assigned_at") @db.Timestamptz(6)
  endedAt                  DateTime?          @map("ended_at") @db.Timestamptz(6)
  userIdentity             UserIdentity       @relation("PlatformRoleUser", fields: [userIdentityId], references: [id], onDelete: Restrict)
  assignedBy               UserIdentity?      @relation("PlatformRoleAssignedBy", fields: [assignedByUserIdentityId], references: [id], onDelete: SetNull)

  @@unique([userIdentityId, roleCode])
  @@index([status, roleCode])
  @@index([assignedByUserIdentityId])
  @@map("platform_role_assignments")
}

model AuditEvent {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String?       @map("workspace_id") @db.Uuid
  actorUserIdentityId String?       @map("actor_user_identity_id") @db.Uuid
  actorMembershipId   String?       @map("actor_membership_id") @db.Uuid
  action              String        @db.VarChar(120)
  outcome             AuditOutcome
  targetType          String?       @map("target_type") @db.VarChar(80)
  targetId            String?       @map("target_id") @db.VarChar(160)
  requestId           String        @map("request_id") @db.VarChar(160)
  metadata            Json?
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace           Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actorUserIdentity   UserIdentity? @relation("AuditActor", fields: [actorUserIdentityId], references: [id], onDelete: SetNull)
  actorMembership     Membership?   @relation("AuditMembership", fields: [workspaceId, actorMembershipId], references: [workspaceId, id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([actorUserIdentityId, createdAt])
  @@index([actorMembershipId])
  @@index([action, createdAt])
  @@map("audit_events")
}

model FeatureFlag {
  id                 String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                String                         @unique @db.VarChar(80)
  displayName        String                         @map("display_name") @db.VarChar(160)
  description        String                         @db.VarChar(500)
  globalEnabled      Boolean                        @default(false) @map("global_enabled")
  zaytoUsersEnabled  Boolean                        @default(false) @map("zayto_users_enabled")
  status             FeatureFlagStatus              @default(ACTIVE)
  createdAt          DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspaceOverrides WorkspaceFeatureFlagOverride[]

  @@index([status])
  @@map("feature_flags")
}

model WorkspaceFeatureFlagOverride {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId             String        @map("workspace_id") @db.Uuid
  featureFlagId           String        @map("feature_flag_id") @db.Uuid
  enabled                 Boolean
  changedByUserIdentityId String?       @map("changed_by_user_identity_id") @db.Uuid
  changedAt               DateTime      @default(now()) @map("changed_at") @db.Timestamptz(6)
  workspace               Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  featureFlag             FeatureFlag   @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)
  changedBy               UserIdentity? @relation("FeatureFlagChangedBy", fields: [changedByUserIdentityId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, featureFlagId])
  @@index([featureFlagId])
  @@index([changedByUserIdentityId])
  @@map("workspace_feature_flag_overrides")
}

model Contact {
  id                            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId                   String                   @map("workspace_id") @db.Uuid
  kind                          ContactKind
  reference                     String                   @db.VarChar(20)
  status                        ContactStatus            @default(ACTIVE)
  title                         String?                  @db.VarChar(40)
  firstName                     String?                  @map("first_name") @db.VarChar(100)
  middleNames                   String?                  @map("middle_names") @db.VarChar(200)
  lastName                      String?                  @map("last_name") @db.VarChar(100)
  preferredName                 String?                  @map("preferred_name") @db.VarChar(100)
  organisationType              OrganisationType?        @map("organisation_type")
  legalName                     String?                  @map("legal_name") @db.VarChar(200)
  tradingName                   String?                  @map("trading_name") @db.VarChar(200)
  registrationNumber            String?                  @map("registration_number") @db.VarChar(64)
  normalizedRegistrationNumber  String?                  @map("normalized_registration_number") @db.VarChar(64)
  vatNumber                     String?                  @map("vat_number") @db.VarChar(32)
  normalizedVatNumber           String?                  @map("normalized_vat_number") @db.VarChar(32)
  preferredCommunicationChannel CommunicationChannel?    @map("preferred_communication_channel")
  doNotEmail                    Boolean                  @default(false) @map("do_not_email")
  doNotTelephone                Boolean                  @default(false) @map("do_not_telephone")
  doNotSms                      Boolean                  @default(false) @map("do_not_sms")
  doNotWhatsApp                 Boolean                  @default(false) @map("do_not_whatsapp")
  doNotPost                     Boolean                  @default(false) @map("do_not_post")
  mergedIntoContactId           String?                  @map("merged_into_contact_id") @db.Uuid
  archivedAt                    DateTime?                @map("archived_at") @db.Timestamptz(6)
  createdByMembershipId         String                   @map("created_by_membership_id") @db.Uuid
  createdAt                     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace                     Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdByMembership           Membership               @relation("ContactCreatedBy", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: Restrict)
  mergedIntoContact             Contact?                 @relation("ContactMerge", fields: [workspaceId, mergedIntoContactId], references: [workspaceId, id], onDelete: Restrict)
  mergedContacts                Contact[]                @relation("ContactMerge")
  contactPoints                 ContactPoint[]
  addresses                     ContactAddress[]
  organisationLinks             OrganisationPersonLink[] @relation("OrganisationContact")
  personLinks                   OrganisationPersonLink[] @relation("PersonContact")
  branchLinks                   ContactBranchLink[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, reference])
  @@index([workspaceId, status])
  @@index([workspaceId, kind, lastName])
  @@index([workspaceId, kind, legalName])
  @@index([workspaceId, normalizedRegistrationNumber])
  @@index([workspaceId, normalizedVatNumber])
  @@index([workspaceId, mergedIntoContactId])
  @@index([workspaceId, createdByMembershipId])
  @@map("contacts")
}

model ContactPoint {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String           @map("workspace_id") @db.Uuid
  contactId       String           @map("contact_id") @db.Uuid
  kind            ContactPointKind
  label           String?          @db.VarChar(40)
  value           String           @db.VarChar(254)
  normalizedValue String           @map("normalized_value") @db.VarChar(254)
  isPreferred     Boolean          @default(false) @map("is_preferred")
  archivedAt      DateTime?        @map("archived_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  contact         Contact          @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([workspaceId, contactId, kind])
  @@index([workspaceId, kind, normalizedValue])
  @@map("contact_points")
}

model ContactAddress {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String             @map("workspace_id") @db.Uuid
  contactId    String             @map("contact_id") @db.Uuid
  kind         ContactAddressKind
  addressLine1 String             @map("address_line_1") @db.VarChar(160)
  addressLine2 String?            @map("address_line_2") @db.VarChar(160)
  locality     String?            @db.VarChar(100)
  townCity     String             @map("town_city") @db.VarChar(100)
  county       String?            @db.VarChar(100)
  postcode     String             @db.VarChar(16)
  countryCode  String             @default("GB") @map("country_code") @db.Char(2)
  archivedAt   DateTime?          @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  contact      Contact            @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([workspaceId, contactId, kind])
  @@index([workspaceId, postcode])
  @@map("contact_addresses")
}

model OrganisationPersonLink {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId           String    @map("workspace_id") @db.Uuid
  organisationContactId String    @map("organisation_contact_id") @db.Uuid
  personContactId       String    @map("person_contact_id") @db.Uuid
  relationshipLabel     String?   @map("relationship_label") @db.VarChar(100)
  isPrimary             Boolean   @default(false) @map("is_primary")
  startedAt             DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt               DateTime? @map("ended_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  organisationContact   Contact   @relation("OrganisationContact", fields: [workspaceId, organisationContactId], references: [workspaceId, id], onDelete: Restrict)
  personContact         Contact   @relation("PersonContact", fields: [workspaceId, personContactId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([workspaceId, organisationContactId, endedAt])
  @@index([workspaceId, personContactId, endedAt])
  @@map("organisation_person_links")
}

model ContactBranchLink {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId           String     @map("workspace_id") @db.Uuid
  contactId             String     @map("contact_id") @db.Uuid
  branchId              String     @map("branch_id") @db.Uuid
  isPrimary             Boolean    @default(false) @map("is_primary")
  startedAt             DateTime   @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt               DateTime?  @map("ended_at") @db.Timestamptz(6)
  createdByMembershipId String     @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  contact               Contact    @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Restrict)
  branch                Branch     @relation(fields: [workspaceId, branchId], references: [workspaceId, id], onDelete: Restrict)
  createdByMembership   Membership @relation("ContactBranchLinkCreatedBy", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([workspaceId, contactId, endedAt])
  @@index([workspaceId, branchId, endedAt])
  @@index([workspaceId, createdByMembershipId])
  @@map("contact_branch_links")
}
